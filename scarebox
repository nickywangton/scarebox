      '<h3>No account.</h3><p>Sign in to see your Box.</p>' +
      '<button class="btn primary" data-action="open-auth">Sign in</button></div></div>';
  }
  const isMe = me && me.id === u.id;
  const uploads = userUploads(u.id);
  const approved = uploads.filter(p => p.status === 'approved');
  const favs = DB.favorites.filter(f => f.user_id === u.id);
  const downloads = DB.downloads.filter(d => d.user_id === u.id);
  const restores = DB.packs.filter(p => (p.restorers || []).includes(u.id)).length;
  const totalDownloads = uploads.reduce((a, p) => a + (p.download_count || 0), 0);
  const tp = trustProgress(u);
  const b = u.badges || {};

  let tabs = [['uploads','Uploads'],['favorites','Favorites'],['downloads','Downloads'],['requests','Requests']];
  if (isMe) tabs.push(['pending','Pending']);

