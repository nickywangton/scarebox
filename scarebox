  else if (S.profileTab === 'favorites') items = favs.map(f => DB.packs.find(p => p.id === f.pack_id)).filter(p => p && p.status === 'approved');
  else if (S.profileTab === 'downloads') items = downloads.map(d => DB.packs.find(p => p.id === d.pack_id)).filter(Boolean);
  else if (S.profileTab === 'pending') items = uploads.filter(p => p.status !== 'approved');

