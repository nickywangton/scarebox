  return '<div class="av ' + size + '" style="background:' + bg + ';' + (extraStyle || '') + '">' + esc(initials) + '</div>';
}
function healthDots(mirrors){
  const list = (mirrors || []).slice(0, 4);
  if (!list.length) return '<span class="dot dead"></span>';
  return list.map(m => '<span class="dot ' + (m.status === 'ok' ? 'ok' : m.status === 'warn' ? 'warn' : 'dead') + '"></span>').join('');
}
function packHealth(p){
  const ms = p.mirrors || [];
  if (!ms.length) return 'dead';
  if (ms.some(m => m.status === 'ok')) return 'ok';
  if (ms.some(m => m.status === 'warn')) return 'warn';
  return 'dead';
}
function userByHandle(h){ return DB.users.find(u => u.handle.toLowerCase() === String(h || '').toLowerCase()); }
function userById(id){ return DB.users.find(u => u.id === id); }
function approvedPacks(){ return DB.packs.filter(p => p.status === 'approved'); }
function packFavCount(id){ return DB.favorites.filter(f => f.pack_id === id).length; }
function isFav(id){ const u = currentUser(); return !!u && DB.favorites.some(f => f.pack_id === id && f.user_id === u.id); }
function commentCount(id){ return DB.comments.filter(c => c.pack_id === id).length; }
function userUploads(id){ return DB.packs.filter(p => p.owner_id === id); }
function trustProgress(u){
  const t = u.trust_score || 0;
  if (t >= 90) return { label: 'Elite', next: 100, pct: 100 };
  if (t >= 60) return { label: 'Trusted', next: 90, pct: t };
  if (t >= 25) return { label: 'Contributor', next: 60, pct: t };
  return { label: 'New', next: 25, pct: t };
}
function recomputeTrust(u){
  const packs = userUploads(u.id);
  const approved = packs.filter(p => p.status === 'approved').length;
  const downloads = packs.reduce((a, p) => a + (p.download_count || 0), 0);
  const restored = DB.packs.filter(p => (p.restorers || []).includes(u.id)).length;
  let score = Math.min(60, approved * 6) + Math.min(25, Math.floor(downloads / 40)) + Math.min(15, restored * 5);
  u.trust_score = Math.max(0, Math.min(100, score));
  if (u.trust_score >= 60 && RANK[u.role] < 3) u.role = 'trusted';
  if (u.trust_score >= 60) u.badges = Object.assign({}, u.badges, { trusted: true });
  if (approved >= 10) u.badges = Object.assign({}, u.badges, { top: true });
  if (restored >= 3) u.badges = Object.assign({}, u.badges, { helper: true });
}

