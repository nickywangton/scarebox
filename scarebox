<div class="atmos">
  <div class="orb a"></div><div class="orb b"></div><div class="orb c"></div>
</div>
<div class="grain"></div>
<div class="vig"></div>

<!-- ============================ WELCOME ============================ -->
<div id="welcome" class="screen">
  <div class="floaters" id="floaters"></div>
  <div class="wpanel glass">
    <div class="logo-wrap">
      <svg viewBox="0 0 64 64" aria-hidden="true">
        <defs>
          <linearGradient id="lg1" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="var(--accent)"/><stop offset="1" stop-color="var(--accent-2)"/>
          </linearGradient>
          <radialGradient id="ig1" cx="50%" cy="30%" r="70%">
            <stop offset="0" stop-color="#fff" stop-opacity=".5"/><stop offset="1" stop-color="#fff" stop-opacity="0"/>
