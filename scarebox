<script>
"use strict";
/* ============================================================================
   SCAREBOX — APPLICATION
   Architecture: index-not-host. ScareBox stores metadata + mirror links.
   Storage: localStorage (client-side). See Admin → Backend for the SQL schema
   to move this to Supabase for a real multi-user deployment.
   ============================================================================ */

/* ---------------------------------------------------------------- UTIL ---- */
const $  = (s, r = document) => r.querySelector(s);
const $$ = (s, r = document) => Array.from(r.querySelectorAll(s));
const uid = () => (crypto.randomUUID ? crypto.randomUUID()
  : 'id_' + Date.now().toString(36) + Math.random().toString(36).slice(2, 10));

const esc = s => String(s == null ? '' : s).replace(/[&<>"']/g,
  c => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c]));

function nf(n){ n = +n || 0;
  if (n >= 1e6) return (n/1e6).toFixed(1).replace(/\.0$/,'') + 'M';
  if (n >= 1e3) return (n/1e3).toFixed(1).replace(/\.0$/,'') + 'k';
  return String(n);
}
function ago(ts){
  const d = Date.now() - ts, m = 6e4, h = 36e5, dy = 864e5;
  if (d < m) return 'just now';
  if (d < h) return Math.floor(d/m) + 'm ago';
  if (d < dy) return Math.floor(d/h) + 'h ago';
  if (d < dy*30) return Math.floor(d/dy) + 'd ago';
  if (d < dy*365) return Math.floor(d/dy/30) + 'mo ago';
  return Math.floor(d/dy/365) + 'y ago';
}
function hashStr(s){ let h = 2166136261;
  for (let i = 0; i < s.length; i++){ h ^= s.charCodeAt(i); h = Math.imul(h, 16777619); }
  return h >>> 0;
}
/* deterministic mesh gradient for a pack thumbnail */
function meshFor(seed){
  const h = hashStr(seed), a = h % 360, b = (a + 47 + (h >> 3) % 90) % 360;
  return `radial-gradient(120% 110% at 18% 8%, hsl(${a} 82% 46% / .72), transparent 58%),` +
         `radial-gradient(120% 110% at 86% 92%, hsl(${b} 86% 52% / .62), transparent 60%),` +
         `linear-gradient(158deg,#15151f,#08080d)`;
}
function meshPreset(i){
