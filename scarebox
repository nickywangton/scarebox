function syncUploadFromDOM(){
  const u = S.upload;
  if (!u) return;
  $$('[data-up]').forEach(el => {
    const k = el.dataset.up;
    if (k === 'mirror-url'){ u.mirrors[+el.dataset.idx].url = el.value; }
    else if (k === 'mirror-host'){ u.mirrors[+el.dataset.idx].host = el.value; }
    else if (k === 'tags'){ /* handled by chips */ }
    else if (k in u){ u[k] = el.value; }
  });
}

