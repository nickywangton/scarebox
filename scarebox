  html += '<div class="handle">@' + esc(u.handle) + (u.location ? ' · ' + esc(u.location) : '') + ' · joined ' + ago(u.created_at) + '</div>';
  if (u.bio) html += '<p class="bio">' + esc(u.bio) + '</p>';
  html += '<div class="badge-row">';
  if (b.top) html += '<span class="bdg top">Top Contributor</span>';
  if (b.trusted) html += '<span class="bdg trusted">Trusted</span>';
  if (b.helper) html += '<span class="bdg helper">Helper</span>';
  if (RANK[roleOf(u)] >= 4) html += '<span class="bdg">' + esc(roleOf(u).toUpperCase()) + '</span>';
  html += '<span class="bdg">' + approved.length + ' packs</span>';
  html += '</div></div>';
  html += '<div style="display:flex;gap:9px;padding-bottom:6px">';
  if (isMe) html += '<button class="btn" data-action="open-drawer">' + I.cog + ' Customize</button>';
  html += '</div></div>';

  html += '<div class="stats">' +
    '<div class="stat"><b>' + nf(approved.length) + '</b><span>Uploads</span></div>' +
    '<div class="stat"><b>' + nf(totalDownloads) + '</b><span>Downloads</span></div>' +
    '<div class="stat"><b>' + nf(favs.length) + '</b><span>Favorites</span></div>' +
    '<div class="stat"><b>' + nf(restores) + '</b><span>Re-uploads</span></div>' +
  '</div>';

  html += '<div class="trust"><div class="trust-head"><span>Trust level — ' + esc(tp.label) + '</span>' +
    '<span>' + (u.trust_score || 0) + ' / ' + tp.next + '</span></div>' +
    '<div class="bar"><i style="width:' + Math.min(100, Math.round(((u.trust_score || 0) / tp.next) * 100)) + '%"></i></div>' +
    '<div class="hint">Approved packs, downloads and restored links raise your trust. Trusted contributors publish instantly.</div></div>';

  html += '<div class="tabs">' + tabs.map(([k, label]) =>
    '<button class="tab' + (S.profileTab === k ? ' active' : '') + '" data-action="prof-tab" data-tab="' + k + '">' + label + '</button>').join('') + '</div>';

  html += '<div style="margin-top:18px">';
