      '<span class="bdg ' + (p.status === 'approved' ? 'trusted' : p.status === 'rejected' ? '' : 'helper') + '">' +
        (p.status === 'pending' ? 'In review' : p.status === 'rejected' ? 'Rejected' : p.status) + '</span>' +
    '</div>').join('');
  } else {
    html += '<div class="' + (S.viewMode === 'grid' ? 'grid' : 'list') + '">' + items.map(cardHTML).join('') + '</div>';
  }
  html += '</div></div>';
  return html;
}

