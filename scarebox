/* ------------------------------------------------------------- LIBRARY --- */
function viewLibrary(){
  const tags = ['All'].concat(TAGS.slice(0, 8));
  let html = '<div class="wrap">';
  html += '<div class="chiprow">' +
    ['All'].concat(CATEGORIES).map(cat =>
      '<button class="chip' + (S.filter.category === cat ? ' active' : '') + '" data-action="filter-cat" data-cat="' + esc(cat) + '">' + esc(cat) + '</button>'
    ).join('') +
    '<div class="divider-v"></div>' +
    '<select class="input" style="width:auto;padding:6px 30px 6px 11px;font-size:12.5px" data-action="sort">' +
      ['recent','popular','title','downloads'].map(s =>
        '<option value="' + s + '"' + (S.filter.sort === s ? ' selected' : '') + '>' +
        ({ recent:'Newest', popular:'Most favorited', title:'A–Z', downloads:'Most downloaded' })[s] + '</option>').join('') +
    '</select>' +
  '</div>';

  html += '<div class="chiprow">' +
    tags.map(t =>
      '<button class="chip tag' + (S.filter.tag === t ? ' active' : '') + '" data-action="filter-tag" data-tag="' + esc(t) + '">' + esc(t) + '</button>'
    ).join('') +
  '</div>';

  html += '<div id="packGrid">' + gridHTML() + '</div></div>';
  return html;
}

function filteredPacks(){
  let list = approvedPacks();
  const f = S.filter;
  if (f.category !== 'All') list = list.filter(p => p.category === f.category);
  if (f.tag !== 'All') list = list.filter(p => (p.tags || []).includes(f.tag));
  if (f.q){
    const q = f.q.toLowerCase();
    const owners = DB.users.filter(u =>
      u.handle.toLowerCase().includes(q) || (u.display_name || '').toLowerCase().includes(q)
    ).map(u => u.id);
    list = list.filter(p =>
      (p.title || '').toLowerCase().includes(q) ||
      (p.source || '').toLowerCase().includes(q) ||
      (p.description || '').toLowerCase().includes(q) ||
      (p.category || '').toLowerCase().includes(q) ||
      (p.tags || []).some(t => t.toLowerCase().includes(q)) ||
      owners.includes(p.owner_id)
    );
  }
  const s = f.sort;
  list = list.slice().sort((a, b) => {
    if (s === 'recent') return (b.created_at || 0) - (a.created_at || 0);
    if (s === 'popular') return packFavCount(b.id) - packFavCount(a.id);
    if (s === 'downloads') return (b.download_count || 0) - (a.download_count || 0);
    return (a.title || '').localeCompare(b.title || '');
  });
  return list;
}

function gridHTML(){
