      '<div class="field"><label>Surface opacity — <span id="alphaVal">' + (u.alpha != null ? u.alpha : 5.5) + '%</span></label>' +
        '<input type="range" class="slider" min="1" max="18" step="0.5" value="' + (u.alpha != null ? u.alpha : 5.5) + '" data-cf-range="alpha"></div>' +

      '<div class="field"><label>Badges</label>' +
        toggleRow('Top Contributor', 'top', !!b.top) +
        toggleRow('Trusted', 'trusted', !!b.trusted) +
        toggleRow('Helper', 'helper', !!b.helper) +
      '</div>' +

      '<div class="field"><label>Privacy</label>' +
        toggleRow('Public profile', 'publicProfile', pv.publicProfile !== false) +
        toggleRow('Show stats', 'showStats', pv.showStats !== false) +
        toggleRow('Show trust level', 'showTrust', pv.showTrust !== false) +
      '</div>' +
    '</div>' +
    '<div class="drawer-foot">' +
      '<button class="btn ghost" data-action="reset-profile">Reset</button>' +
      '<button class="btn primary block" data-action="save-profile">Save changes</button>' +
    '</div>';

  openDrawer(html);

  $$('[data-cf-range]').forEach(r => r.addEventListener('input', e => {
    const k = e.target.dataset.cfRange, v = +e.target.value;
    if (k === 'blur'){ document.documentElement.style.setProperty('--blur', v + 'px'); $('#blurVal').textContent = v + 'px'; }
    if (k === 'alpha'){ document.documentElement.style.setProperty('--surface-a', String(v/100)); $('#alphaVal').textContent = v + '%'; }
  }));
}
function toggleRow(label, key, on){
  return '<div class="toggle-row"><span>' + esc(label) + '</span>' +
    '<button class="switch' + (on ? ' on' : '') + '" data-action="toggle-flag" data-key="' + key + '"></button></div>';
}

