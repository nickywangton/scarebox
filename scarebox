}
function isGuest(){ return !!DB.session && DB.session.id === 'guest'; }
function isAuthed(){ return !!currentUser(); }
function roleOf(u){ return u ? (u.role || 'member') : 'visitor'; }
function can(action){
  const r = RANK[roleOf(currentUser())] || 0;
  switch (action){
    case 'favorite': case 'comment': case 'request': return r >= 1;
    case 'upload': return r >= 2;
    case 'moderate': return r >= 4;
    case 'admin': return r >= 5;
    default: return true;
  }
}
