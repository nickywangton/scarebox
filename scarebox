const ACTIONS = {

  /* navigation */
  nav(el){ S.view = el.dataset.view; S.pageSlug = null; S.sidebarOpen = false;
    if (S.view === 'profile') S.profileUser = null;
    if (S.view === 'upload' && !S.upload) S.upload = newUpload();
    closeModal(); closeSheet(); closeDrawer(); render(); },
  page(el){ S.pageSlug = el.dataset.slug; S.view = 'page'; render(); },
  'toggle-sidebar'(){ S.sidebarOpen = !S.sidebarOpen; $('#sidebar').classList.toggle('open', S.sidebarOpen); },
  theme(){ toggleTheme(); },
  'view-mode'(el){ S.viewMode = el.dataset.mode; renderToolbar(); renderView(); },
  'clear-filters'(){ S.filter = { q:'', category:'All', tag:'All', sort:'recent' }; render(); },
  'filter-cat'(el){ S.filter.category = el.dataset.cat; renderView(); },
  'filter-tag'(el){ S.filter.tag = el.dataset.tag; renderView(); },
  'prof-tab'(el){ S.profileTab = el.dataset.tab; renderView(); },

  /* auth */
  'auth-mode'(el){ S.authMode = el.dataset.mode; renderWelcome(); },
  'guest-enter'(){
    if (!$('#agreeBox').checked) return toast('Please accept the community rules first.', 'warn');
    DB.session = { id: 'guest' }; persist(); S.view = 'library'; render();
  },
  'open-auth'(){ S.authMode = 'signup'; showWelcomeScreen(); },
  async signup(){
    const name = $('#suName').value.trim();
    const handle = $('#suHandle').value.trim().replace(/^@/, '');
    const email = $('#suEmail').value.trim().toLowerCase();
    const pass = $('#suPass').value;
    const err = $('#suErr');
    err.innerHTML = '';

    if (!$('#agreeBox').checked) { err.innerHTML = '<div class="err">Accept the community rules to continue.</div>'; return; }
    if (name.length < 2) { err.innerHTML = '<div class="err">Enter a display name.</div>'; return; }
    if (!/^[a-zA-Z0-9._]{2,30}$/.test(handle)) { err.innerHTML = '<div class="err">Handle must be 2–30 characters: letters, numbers, dot, underscore.</div>'; return; }
    if (DB.users.some(u => u.handle.toLowerCase() === handle.toLowerCase())) { err.innerHTML = '<div class="err">That handle is taken.</div>'; return; }
    if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) { err.innerHTML = '<div class="err">Enter a valid email.</div>'; return; }
    if (DB.users.some(u => u.email === email)) { err.innerHTML = '<div class="err">An account with that email already exists.</div>'; return; }
    if (pass.length < 8) { err.innerHTML = '<div class="err">Password must be at least 8 characters.</div>'; return; }

    const { salt, hash } = await hashPassword(pass);
    const first = DB.users.length === 0;
    const user = {
      id: uid(), handle, display_name: name, email, salt, hash,
      bio: '', location: '', initials: name.slice(0,2).toUpperCase(),
      avatar_idx: Math.floor(Math.random() * AVATAR_GRADS.length),
      cover_idx: 0, accent_idx: 0, blur: 34, alpha: 5.5,
      badges: first ? { top:true, trusted:true, helper:true, verified:true } : { verified:true },
      privacy: { publicProfile:true, showStats:true, showTrust:true },
      role: first ? 'admin' : 'contributor',
      trust_score: first ? 100 : 0,
      created_at: Date.now()
    };
    DB.users.push(user);
    DB.session = { id: user.id };
    persist();
    toast(first ? 'Welcome, admin. This Box is yours to seed.' : 'Account created. Welcome to ScareBox.', 'ok');
    S.view = 'library';
    render();
  },
  async signin(){
    const id = $('#siId').value.trim().replace(/^@/, '').toLowerCase();
    const pass = $('#siPass').value;
    const err = $('#siErr');
    err.innerHTML = '';
    const u = DB.users.find(x => x.handle.toLowerCase() === id || x.email === id);
    if (!u) { err.innerHTML = '<div class="err">No account found.</div>'; return; }
    const { hash } = await hashPassword(pass, u.salt);
    if (hash !== u.hash) { err.innerHTML = '<div class="err">Incorrect password.</div>'; return; }
    DB.session = { id: u.id }; persist();
    toast('Signed in as @' + u.handle, 'ok');
    S.view = 'library'; render();
  },
  signout(){
    DB.session = null; persist();
    S.view = 'library'; S.authMode = 'choose';
    closeModal(); closeSheet(); closeDrawer();
    render();
    toast('Signed out.');
  },

  /* packs */
  'open-pack'(el){ openPack(el.dataset.id); },
  'close-modal'(){ closeModal(); },
  'close-sheet'(){ closeSheet(); },
  'noop'(){},
  'toggle-fav'(el){
    if (!requireAuth('favorite packs')) return;
    const id = el.dataset.id, u = currentUser();
    const idx = DB.favorites.findIndex(f => f.pack_id === id && f.user_id === u.id);
    if (idx >= 0){ DB.favorites.splice(idx, 1); toast('Removed from favorites.'); }
    else { DB.favorites.push({ user_id: u.id, pack_id: id }); toast('Added to favorites.', 'ok'); }
    persist();
    if ($('.scrim')) openPack(id); else { renderView(); }
  },
  'copy-credit'(el){
    const p = DB.packs.find(x => x.id === el.dataset.id);
    if (!p) return;
    const owner = userById(p.owner_id);
    const text = 'Scenepack by @' + (owner ? owner.handle : 'unknown') + ' on TikTok';
    copy(text).then(() => toast('Credit copied — paste it in your caption.', 'ok'));
  },
  'copy-url'(el){ copy(el.dataset.url).then(() => toast('Link copied.', 'ok')); },
  'copy-sql'(){ copy(SQL_SCHEMA).then(() => toast('Schema copied.', 'ok')); },

  /* download */
  'download-open'(el){ closeModal(); openDownload(el.dataset.id); },
  'download-mirror'(el){
    const p = DB.packs.find(x => x.id === el.dataset.id);
    if (!p) return;
    const m = (p.mirrors || [])[+el.dataset.idx];
    if (!m) return;
    const gate = $('#creditGate');
    if (gate && !gate.checked) return toast('Confirm the credit first.', 'warn');
    const u = currentUser();
    p.download_count = (p.download_count || 0) + 1;
    if (u) DB.downloads.push({ user_id: u.id, pack_id: p.id, at: Date.now() });
    persist();
    window.open(m.url, '_blank', 'noopener');
    toast('Opening ' + m.host + '… Credit @' + (userById(p.owner_id) || {}).handle, 'ok');
    closeSheet();
    renderView();
  },
  'report-mirror'(el){ openReport(el.dataset.id); },
  'report-open'(el){ openReport(el.dataset.id); },
  'report-submit'(el){
    const packId = el.dataset.id;
    const reason = $('#rpReason').value;
    const note = $('#rpNote').value.trim();
    const u = currentUser();
    DB.reports.push({ id: uid(), pack_id: packId, mirror_url: null, reporter_id: u.id,
      reason, note, status: 'open', created_at: Date.now() });
    /* auto-hide a mirror after 3 unique dead-link reports */
    if (reason === 'dead_link'){
      const p = DB.packs.find(x => x.id === packId);
      if (p && p.mirrors && p.mirrors.length){
        p.mirrors[0].status = p.mirrors[0].status === 'dead' ? 'dead' : 'warn';
      }
    }
    persist();
    closeModal();
    toast('Report filed. Thank you.', 'ok');
    renderView();
  },
  'report-resolve'(el){
    const r = DB.reports.find(x => x.id === el.dataset.id);
    if (r){ r.status = 'resolved'; persist(); renderView(); toast('Report resolved.', 'ok'); }
  },
  'report-dismiss'(el){
    const r = DB.reports.find(x => x.id === el.dataset.id);
    if (r){ r.status = 'dismissed'; persist(); renderView(); toast('Report dismissed.'); }
  },

  /* comments */
  'comment-add'(el){
    if (!requireAuth('comment')) return;
    const input = $('#cmtInput');
    const body = input.value.trim();
    if (!body) return;
    DB.comments.push({ id: uid(), pack_id: el.dataset.id, user_id: currentUser().id,
      body, created_at: Date.now() });
    persist();
    toast('Posted.', 'ok');
    openPack(el.dataset.id);
  },

  /* upload */
  'up-tag'(el){
    syncUploadFromDOM();
    const t = el.dataset.tag, u = S.upload;
    const i = u.tags.indexOf(t);
    if (i >= 0) u.tags.splice(i, 1); else u.tags.push(t);
    renderView();
  },
  'up-add-mirror'(){ syncUploadFromDOM(); S.upload.mirrors.push({ host:'Mega', url:'' }); renderView(); },
  'up-del-mirror'(el){ syncUploadFromDOM(); S.upload.mirrors.splice(+el.dataset.idx, 1); renderView(); },
  'up-back'(){ syncUploadFromDOM(); S.upload.step--; S.upload.error = ''; renderView(); },
  'up-next'(){
    syncUploadFromDOM();
    const u = S.upload;
    u.error = '';
    if (u.step === 2){
      if (u.title.trim().length < 3) { u.error = 'Give your pack a title.'; return renderView(); }
      if (!u.res || RES.indexOf(u.res) < 0) { u.error = 'Pick a resolution.'; return renderView(); }
    }
    if (u.step === 3){
      if (!u.tags.length){ /* tags optional */ }
    }
    if (u.step === 4){
      const valid = u.mirrors.filter(m => /^https?:\/\/.+/i.test(m.url.trim()));
      if (!valid.length){ u.error = 'Add at least one valid mirror URL (starting with http).'; return renderView(); }
      if (valid.length < 3) toast('Only ' + valid.length + ' mirror(s). Three or more is the standard.', 'warn');
    }
    u.step++;
    renderView();
  },
  'up-submit'(){
    syncUploadFromDOM();
    const u = S.upload, me = currentUser();
    const mirrors = u.mirrors
      .filter(m => /^https?:\/\/.+/i.test(m.url.trim()))
      .map(m => ({ host: m.host, url: m.url.trim(), status: 'ok' }));
    if (!mirrors.length) { u.error = 'Add at least one valid mirror URL.'; return renderView(); }

    const trusted = RANK[roleOf(me)] >= 3;
    DB.packs.push({
      id: uid(), owner_id: me.id,
      title: u.title.trim(), category: u.category, tags: u.tags.slice(),
      res: u.res, size: u.size.trim(), clips: +u.clips || 0, format: u.format,
      mirrors, preview_url: u.preview_url.trim(), license: u.license,
      description: u.description.trim(), source: u.source.trim(),
      status: trusted ? 'approved' : 'pending',
      download_count: 0, restorers: [],
      created_at: Date.now(), updated_at: Date.now()
    });
    recomputeTrust(me);
    persist();
    S.upload = newUpload();
    S.view = 'profile';
    S.profileTab = 'pending';
    toast(trusted ? 'Published. Trusted contributors skip the queue.' : 'Submitted. A moderator will review it shortly.', 'ok');
    render();
  },
  'mod-approve'(el){
    const p = DB.packs.find(x => x.id === el.dataset.id);
    if (!p) return;
    p.status = 'approved';
    const owner = userById(p.owner_id);
    if (owner) recomputeTrust(owner);
    persist(); renderView();
    toast('Approved.', 'ok');
  },
  'mod-reject'(el){
    const p = DB.packs.find(x => x.id === el.dataset.id);
    if (!p) return;
    p.status = 'rejected'; persist(); renderView();
    toast('Rejected.', 'warn');
  },
  'set-role'(el){
    const u = userById(el.dataset.id);
    if (!u) return;
    u.role = el.value; persist();
    toast('@' + u.handle + ' is now ' + el.value + '.', 'ok');
  },

  /* requests */
  'req-add'(){
    if (!can('request')) return;
    const title = $('#reqTitle').value.trim();
    if (title.length < 4) return toast('Describe what you need.', 'warn');
    DB.requests.push({ id: uid(), requester_id: currentUser().id, title,
      category: $('#reqCat').value, description: '', upvotes: 1,
      fulfilled_by: null, status: 'open', created_at: Date.now() });
    persist(); renderView();
    toast('Request posted.', 'ok');
  },
  'req-vote'(el){
    if (!requireAuth('upvote requests')) return;
    const u = currentUser(), id = el.dataset.id;
    const r = DB.requests.find(x => x.id === id);
    if (!r) return;
    const i = DB.votes.findIndex(v => v.request_id === id && v.user_id === u.id);
    if (i >= 0){ DB.votes.splice(i,1); r.upvotes = Math.max(0, (r.upvotes||0) - 1); }
    else { DB.votes.push({ request_id:id, user_id:u.id }); r.upvotes = (r.upvotes||0) + 1; }
    persist(); renderView();
  },
  'req-fulfil'(el){
    if (!can('moderate')) return toast('Only moderators can mark requests fulfilled.', 'warn');
    const r = DB.requests.find(x => x.id === el.dataset.id);
    if (!r) return;
    r.status = 'fulfilled'; persist(); renderView();
    toast('Marked fulfilled.', 'ok');
  },

  /* customize */
  'open-drawer'(){ openCustomize(); },
  'close-drawer'(){ closeDrawer(); },
  'set-avatar'(el){
    const u = currentUser(); u.avatar_idx = +el.dataset.i; persist();
    applyAppearance(); render(); openCustomize();
  },
  'set-cover'(el){
    const u = currentUser(); u.cover_idx = +el.dataset.i; persist(); render(); openCustomize();
  },
  'set-accent'(el){
    const u = currentUser(); u.accent_idx = +el.dataset.i; persist();
    applyAppearance(); render(); openCustomize();
  },
  'toggle-flag'(el){
    const u = currentUser(), k = el.dataset.key;
    if (['top','trusted','helper'].includes(k)){
      u.badges = Object.assign({}, u.badges);
      u.badges[k] = !u.badges[k];
    } else {
      u.privacy = Object.assign({}, u.privacy);
      u.privacy[k] = !(u.privacy[k] !== false);
    }
    persist(); openCustomize(); renderSidebar();
  },
  'save-profile'(){
    const u = currentUser();
    $$('[data-cf]').forEach(el => {
      const k = el.dataset.cf;
      let v = el.value;
      if (k === 'handle'){
        v = v.replace(/^@/,'').trim();
        if (!/^[a-zA-Z0-9._]{2,30}$/.test(v)) { toast('Invalid handle.', 'err'); return; }
        if (DB.users.some(x => x.id !== u.id && x.handle.toLowerCase() === v.toLowerCase())) {
          toast('That handle is taken.', 'err'); return;
        }
      }
      if (k === 'initials') v = v.slice(0,2).toUpperCase();
      u[k] = v;
    });
    $$('[data-cf-range]').forEach(r => { u[r.dataset.cfRange] = +r.value; });
    u.updated_at = Date.now();
    persist();
    applyAppearance();
    closeDrawer();
    toast('Profile saved.', 'ok');
    render();
  },
  'reset-profile'(){
    const u = currentUser();
    u.bio = ''; u.location = ''; u.avatar_idx = 0; u.cover_idx = 0;
    u.accent_idx = 0; u.blur = 34; u.alpha = 5.5;
    persist(); applyAppearance(); render(); openCustomize();
    toast('Reset to defaults.');
  },

  /* data */
  'export-db'(){
    const blob = new Blob([JSON.stringify(DB, null, 2)], { type:'application/json' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'scarebox-export-' + new Date().toISOString().slice(0,10) + '.json';
    a.click();
    URL.revokeObjectURL(a.href);
    toast('Exported.', 'ok');
  },
  'wipe-db'(){
    if (!confirm('Erase everything? Packs, accounts, favorites — all of it. This cannot be undone.')) return;
    localStorage.removeItem(DB_KEY);
    DB = blankDB(); persist();
    S.view = 'library'; S.authMode = 'choose';
    render();
    toast('Everything erased.', 'warn');
  }
};

/* ---------------------------------------------------------------- CLICK -- */
document.addEventListener('click', e => {
  const el = e.target.closest('[data-action]');
  if (!el) return;
  const action = el.dataset.action;
  const fn = ACTIONS[action];
  if (!fn) return;
  if (el.tagName === 'SELECT' && action === 'set-role') return; /* handled on change */
  if (el.tagName === 'INPUT' && el.type === 'checkbox') return;
  e.preventDefault();
  fn(el);
});
document.addEventListener('change', e => {
  const el = e.target;
  if (el.dataset.action === 'set-role'){ ACTIONS['set-role'](el); return; }
  if (el.dataset.action === 'sort'){ S.filter.sort = el.value; renderGrid(); return; }
  if (el.tagName === 'SELECT' && el.dataset.up){ syncUploadFromDOM(); }
});
document.addEventListener('input', e => {
  if (e.target.dataset && e.target.dataset.up) {
    /* keep local state current as user types so step changes don't lose data */
    const u = S.upload;
    if (!u) return;
    const k = e.target.dataset.up;
    if (k === 'mirror-url') u.mirrors[+e.target.dataset.idx].url = e.target.value;
    else if (k === 'mirror-host') u.mirrors[+e.target.dataset.idx].host = e.target.value;
  }
});

/* --------------------------------------------------------------- KEYS ---- */
document.addEventListener('keydown', e => {
  if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k'){
    e.preventDefault();
    if (S.view !== 'library'){ S.view = 'library'; render(); }
    const q = $('#q'); if (q) q.focus();
  }
  if (e.key === 'Escape'){
    if ($('#modalRoot .drawer')) closeDrawer();
    else if ($('#sheetRoot .sheet')) closeSheet();
    else if ($('#modalRoot .scrim')) closeModal();
    else if (S.sidebarOpen){ S.sidebarOpen = false; $('#sidebar').classList.remove('open'); }
  }
});

/* ---------------------------------------------------------------- INIT --- */
function showWelcomeScreen(){
  DB.session = null;
  $('#welcome').classList.remove('hidden');
  $('#app').classList.add('hidden');
  renderWelcome();
  renderFloaters();
}

function copy(text){
  if (navigator.clipboard && window.isSecureContext){
    return navigator.clipboard.writeText(text).catch(() => fallbackCopy(text));
  }
  return Promise.resolve(fallbackCopy(text));
}
function fallbackCopy(text){
  const ta = document.createElement('textarea');
  ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0';
  document.body.appendChild(ta); ta.select();
  try { document.execCommand('copy'); } catch (e) {}
  ta.remove();
}

function init(){
  applyTheme();
  loadDB();
  applyAppearance();
  renderFloaters();
  render();

  const fileInput = () => $('#importFile');
  document.addEventListener('change', e => {
    if (e.target.id !== 'importFile') return;
    const file = e.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = () => {
      try {
        const data = JSON.parse(reader.result);
        if (!data || typeof data !== 'object' || !Array.isArray(data.users)) throw new Error('bad');
        DB = Object.assign(blankDB(), data);
        persist();
        applyAppearance();
        render();
        toast('Imported ' + DB.packs.length + ' packs.', 'ok');
      } catch (err) {
        toast('That file is not a valid ScareBox export.', 'err');
      }
    };
    reader.readAsText(file);
    e.target.value = '';
  });

  window.addEventListener('resize', () => {
    if (window.innerWidth > 920 && S.sidebarOpen){
      S.sidebarOpen = false;
      $('#sidebar').classList.remove('open');
    }
  });

  /* first run hint */
  if (!localStorage.getItem('scarebox.hinted')){
    localStorage.setItem('scarebox.hinted', '1');
  }
}

init();
</script>
